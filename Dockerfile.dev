FROM php:8.3-fpm-alpine


RUN apk update \
  && apk --no-cache add \
    mysql-client \
    tar \
    libpq-dev \
    libical-dev \
    curl \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    oniguruma-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    nginx \
    supervisor \
    libcap \
    git \
    autoconf g++ imagemagick imagemagick-dev libtool make pcre-dev


RUN docker-php-ext-configure gd \
        --with-jpeg=/usr/include/ \
        --with-freetype=/usr/include/ \
    && docker-php-ext-install pdo_mysql mysqli mbstring exif pcntl bcmath gd calendar zip opcache


RUN pecl install imagick && docker-php-ext-enable imagick \
    && pecl install redis && docker-php-ext-enable redis


RUN apk del autoconf g++ libtool make pcre-dev


COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www


RUN adduser -D -u 1000 -G www-data laravel \
    && mkdir -p /home/laravel/.composer \
    && chown -R laravel:www-data /home/laravel \
    && chown laravel:www-data /var/www
RUN git config --global --add safe.directory /var/www    


RUN mkdir -p \
    /var/lib/nginx/tmp/client_body \
    /var/log/nginx \
    /var/run/nginx \
    /var/run/supervisor \
    /var/log/supervisor \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    && chown -R laravel:www-data \
        /var/lib/nginx \
        /var/log/nginx \
        /var/run/nginx \
        /var/run/supervisor \
        /var/log/supervisor \
        storage \
    && chmod -R 775 \
        /var/lib/nginx \
        /var/log/nginx \
        /var/run/nginx \
        /var/run/supervisor \
        /var/log/supervisor \
    && chmod -R 777 storage \
    && touch /var/log/supervisor/supervisord.log \
    && chmod 777 /var/log/supervisor/supervisord.log


RUN setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx


COPY --chown=laravel:www-data docker/supervisord.conf /etc/supervisord.conf
COPY --chown=laravel:www-data docker/php.ini /usr/local/etc/php/conf.d/app.ini
COPY --chown=laravel:www-data docker/default.conf /etc/nginx/http.d/default.conf
COPY --chown=laravel:www-data docker/nginx.conf /etc/nginx/nginx.conf


COPY --chown=laravel:www-data composer.json  .
RUN composer install --no-scripts
COPY . .

RUN composer dump-autoload


COPY --chown=laravel:www-data . .

RUN chmod +x /var/www/docker/run.sh

USER laravel

EXPOSE 9000 80 443

ENTRYPOINT ["/var/www/docker/run.sh"]
