# Node artifact files
node_modules/
dist/
vendor/
postman/
.env
storage/app/
storage/logs/
storage/quality-reports/
composer.lock

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


#
.vscode/


# Local MCP configuration
.agents/mcp_config.json
.ai/mcp/mcp.json

# PHPUnit cache
.phpunit.result.cache

# Laravel runtime cache
/storage/framework/cache/*
/storage/framework/views/*
